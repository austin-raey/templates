{
	"name": "@slowpoketail/oxc",
	"version": "1.1.1",
	"description": "Shareable configurations for Oxlint and Oxfmt",
	"keywords": [
		"configuration",
		"eslint",
		"oxc",
		"oxfmt",
		"oxlint",
		"shareable"
	],
	"homepage": "https://github.com/austin-raey/templates",
	"bugs": {
		"url": "https://github.com/austin-raey/templates/issues"
	},
	"license": "MIT",
	"author": "Austin Raey <24833719+austin-raey@users.noreply.github.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/austin-raey/templates.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./fmt": "./dist/fmt.mjs",
		"./lint": "./dist/lint/index.mjs",
		"./lint/astro": "./dist/lint/astro.mjs",
		"./lint/base": "./dist/lint/base.mjs",
		"./lint/next": "./dist/lint/next.mjs",
		"./lint/react": "./dist/lint/react.mjs",
		"./lint/tailwind": "./dist/lint/tailwind.mjs",
		"./lint/unocss": "./dist/lint/unocss.mjs",
		"./lint/wrenjs": "./dist/lint/wrenjs.mjs",
		"./plugins/e18e": "./dist/plugins/e18e.mjs",
		"./plugins/perfectionist": "./dist/plugins/perfectionist.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"dev": "vp pack --watch",
		"test": "vp test",
		"check": "vp check --fix",
		"prepublishOnly": "vp run build"
	},
	"dependencies": {
		"@e18e/eslint-plugin": "catalog:",
		"@unocss/eslint-plugin": "catalog:",
		"eslint-config-preact": "catalog:",
		"eslint-plugin-better-tailwindcss": "catalog:",
		"eslint-plugin-perfectionist": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"rolldown-license-plugin": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"oxfmt": "*",
		"oxlint": "*"
	},
	"peerDependenciesMeta": {
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		}
	},
	"inlinedDependencies": {
		"@e18e/eslint-plugin": "0.8.1",
		"@eslint-community/eslint-utils": "4.10.1",
		"@typescript-eslint/types": "8.71.2",
		"@typescript-eslint/utils": "8.71.2",
		"empathic": "2.1.0",
		"eslint-plugin-perfectionist": "5.12.1",
		"eslint-visitor-keys": "3.4.3",
		"module-replacements": "3.4.0",
		"natural-orderby": "5.0.0",
		"verkit": "0.4.1"
	}
}
